{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    
    
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true, 
    
    "types": [
      "vite/client",              
      "@cloudflare/workers-types"
    ]
  },
  
  "include": [
    "src",              
    "functions",        
    "vite.config.ts"  
  ]
}